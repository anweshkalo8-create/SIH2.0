# ── App ────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-256-bit-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Database ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/oceanverse

# ── Redis ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── INCOIS / upstream data ──────────────────────
INCOIS_API_BASE=https://incois.gov.in/api
CMEMS_USERNAME=your_cmems_user
CMEMS_PASSWORD=your_cmems_password

# ── CORS ────────────────────────────────────────
FRONTEND_ORIGIN=https://ocean-verse-delta.vercel.app
